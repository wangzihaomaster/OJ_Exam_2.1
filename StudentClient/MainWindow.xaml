<Window x:Class="StudentClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="考试监考客户端（学生端）" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen" MinHeight="560" MinWidth="900">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶部：考生信息 ============ -->
        <GroupBox Grid.Row="0" Grid.ColumnSpan="2" Header="考生与比赛信息" Padding="6">
            <UniformGrid Rows="2" Columns="4">
                <StackPanel Margin="4">
                    <TextBlock Text="姓名"/>
                    <TextBox x:Name="TxtStudentName" />
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="学校"/>
                    <TextBox x:Name="TxtSchool"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="学籍号 / 身份证号"/>
                    <TextBox x:Name="TxtIdNumber"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="座位号"/>
                    <TextBox x:Name="TxtSeat"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="比赛名称"/>
                    <TextBox x:Name="TxtContest"/>
                </StackPanel>
                <StackPanel Margin="4" Grid.ColumnSpan="2">
                    <TextBlock Text="考场加密口令（由教师下发，用于导出纪律信息）"/>
                    <PasswordBox x:Name="TxtPassword"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="录屏帧率"/>
                    <ComboBox x:Name="CmbFps" SelectedIndex="1">
                        <ComboBoxItem Content="每 2 秒 1 帧"/>
                        <ComboBoxItem Content="每秒 1 帧"/>
                        <ComboBoxItem Content="每秒 2 帧"/>
                    </ComboBox>
                </StackPanel>
            </UniformGrid>
        </GroupBox>

        <!-- ============ 左侧：状态 + 违规记录 ============ -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,10,10,0">
            <StackPanel DockPanel.Dock="Top">
                <Button x:Name="BtnStart" Content="开始考试（启动录屏与进程监控）"
                        Height="42" FontSize="14" FontWeight="Bold" Click="BtnStart_Click"/>
                <Border Background="#FFF6F6F6" BorderBrush="#FFDDDDDD" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock x:Name="LblRecordState" Text="录屏状态：未开始" FontWeight="Bold"/>
                        <TextBlock x:Name="LblRecordTime" Text="已录制时长：00:00:00"/>
                        <TextBlock x:Name="LblFrameCount" Text="帧数：0"/>
                        <TextBlock x:Name="LblViolationCount" Text="违规次数：0" Foreground="Red"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="违规软件记录：" Margin="0,10,0,4" FontWeight="Bold"/>
            </StackPanel>
            <ListBox x:Name="LstViolations" FontFamily="Consolas" FontSize="12"/>
        </DockPanel>

        <!-- ============ 右侧：题目信息 + 提交代码按钮 ============ -->
        <GroupBox Grid.Row="1" Grid.Column="1" Header="题目信息与代码提交" Margin="0,10,0,0">
            <DockPanel>
                <!-- 题目信息栏（旁边就是提交代码按钮，见需求 4） -->
                <Border DockPanel.Dock="Top" Background="#FFEAF3FF" BorderBrush="#FFB9D4F0"
                        CornerRadius="4" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="当前题目：" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="题号："/>
                                <TextBlock x:Name="LblProblemId" Text="P1001" FontWeight="Bold"/>
                                <TextBlock Text="    题名：" Margin="12,0,0,0"/>
                                <TextBlock x:Name="LblProblemName" Text="A+B 问题" FontWeight="Bold"/>
                                <TextBlock Text="    语言：" Margin="12,0,0,0"/>
                                <TextBlock x:Name="LblLanguage" Text="C++14"/>
                            </StackPanel>
                            <TextBlock x:Name="LblSubmitState" Margin="0,6,0,0" Foreground="Green"
                                       Text="尚未提交"/>
                        </StackPanel>
                        <!-- ★ 在题目信息旁的“提交代码”按钮 ★ -->
                        <Button Grid.Column="1" x:Name="BtnSubmit" Content="提交代码"
                                Width="110" Height="48" FontSize="15" FontWeight="Bold"
                                VerticalAlignment="Center" Margin="12,0,0,0"
                                Background="#FF2E7D32" Foreground="White" Click="BtnSubmit_Click"/>
                    </Grid>
                </Border>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="切换题目："/>
                    <ComboBox x:Name="CmbProblems" Width="260" SelectionChanged="CmbProblems_SelectionChanged"/>
                    <TextBlock Text="语言：" Margin="16,0,0,0"/>
                    <ComboBox x:Name="CmbLang" Width="110" SelectedIndex="0">
                        <ComboBoxItem Content="C++14"/>
                        <ComboBoxItem Content="C"/>
                        <ComboBoxItem Content="Pascal"/>
                        <ComboBoxItem Content="Python3"/>
                    </ComboBox>
                    <Button x:Name="BtnOpenFolder" Content="从文件夹读取源码…" Margin="16,0,0,0"
                            Click="BtnOpenFolder_Click"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="源代码（提交时随纪律信息一同封存）：" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtCode" AcceptsReturn="True" FontFamily="Consolas" FontSize="13"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </GroupBox>

        <!-- ============ 底部：导出 + 日志 ============ -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnExport" Content="导出比赛纪律信息(.disc)" Width="200" Height="34"
                        FontSize="14" IsEnabled="False" Click="BtnExport_Click"/>
                <Button x:Name="BtnStop" Content="结束考试" Width="110" Height="34" Margin="10,0,0,0"
                        Click="BtnStop_Click"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="运行日志：" FontWeight="Bold" Margin="0,0,0,4"/>
            <ScrollViewer x:Name="LogScroll" Height="120" BorderBrush="#FFDDDDDD" BorderThickness="1">
                <TextBox x:Name="TxtLog" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
